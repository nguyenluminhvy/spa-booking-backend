generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  STAFF
  ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
}

enum VoucherType {
  PERCENT
  FIXED
}

model User {
  id                Int            @id @default(autoincrement())
  name              String?
  email             String         @unique
  password          String
  phone             String?
  deviceToken       String?
  role              Role           @default(USER)
  createdAt         DateTime       @default(now())
  status            Status         @default(ACTIVE)
  appointments      Appointment[]  @relation("UserAppointments")
  staffAppointments Appointment[]  @relation("StaffAppointments")
  notifications     Notification[]
  reviews           Review[]

  @@map("users")
}

model Service {
  id           Int           @id @default(autoincrement())
  name         String
  description  String?
  price        Decimal
  duration     Int
  imageUrl     String?
  status       Status        @default(ACTIVE)
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  reviews      Review[]

  @@map("services")
}

model Appointment {
  id      Int  @id @default(autoincrement())
  userId  Int
  staffId Int?

  serviceId       Int
  appointmentDate DateTime
  appointmentTime DateTime
  status          String
  createdAt       DateTime @default(now())
  service         Service  @relation(fields: [serviceId], references: [id])
  user            User     @relation("UserAppointments", fields: [userId], references: [id])
  staff           User?    @relation("StaffAppointments", fields: [staffId], references: [id])

  originalPrice Float?
  finalPrice    Float?
  discount      Float   @default(0)
  voucherCode   String?

  review Review?

  @@map("appointments")
}

model Review {
  id            Int      @id @default(autoincrement())
  userId        Int
  serviceId     Int
  appointmentId Int      @unique
  rating        Int
  tags          String[]
  comment       String?
  createdAt     DateTime @default(now())

  service     Service     @relation(fields: [serviceId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@map("reviews")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

model PasswordReset {
  id         Int      @id @default(autoincrement())
  email      String
  otp        String?
  resetToken String?  @unique
  expiredAt  DateTime
  createdAt  DateTime @default(now())
}

model Voucher {
  id          Int         @id @default(autoincrement())
  code        String      @unique
  type        VoucherType
  value       Float
  maxDiscount Float?
  usageLimit  Int?
  usedCount   Int         @default(0)
  startDate   DateTime
  endDate     DateTime
  status      Status      @default(ACTIVE)
  createdAt   DateTime    @default(now())
}
